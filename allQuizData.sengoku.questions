<script>
    // --- 1. クイズデータベース（構文エラーを完全修正） ---
    const allQuizData = {
        sengoku: { 
            color: "#e74c3c", 
            questions: [
                { name: "織田信長", prompt: "A realistic portrait of Oda Nobunaga, black lacquer armor, burning temple background", msg: "私が掲げた、武力によって天下を統一するというスローガンは何？", answers: ["天下布武", "てんかふぶ"], info: "1567年頃から使い始めた印章に記されています。" },
                { name: "豊臣秀吉", prompt: "A realistic portrait of Toyotomi Hideyoshi, colorful samurai armor, smiling slightly", msg: "私が天下統一の足がかりとして、大阪に築いた日本最大級の城は何？", answers: ["大坂城", "大阪城", "おおさかじょう"], info: "1583年から築城を開始。当時は「大坂」と表記されていました。" },
                { name: "徳川家康", prompt: "A dignified portrait of Tokugawa Ieyasu, golden armor, calm expression", msg: "江戸幕府が開かれたのは西暦何年か？", answers: ["1603", "1603年"], info: "1603年、家康は征夷大将軍に任命され、江戸に幕府を開きました。" },
                { name: "明智光秀", prompt: "A solemn portrait of Akechi Mitsuhide, light blue armor, temple background", msg: "1582年、私が主君・信長を襲撃した事件を何という？", answers: ["本能寺の変", "ほんのうじのへん"], info: "京都の本能寺に宿泊していた信長を急襲しました。" },
                { name: "武田信玄", prompt: "A powerful portrait of Takeda Shingen, iconic red armor, holding a war fan", msg: "私の軍旗に記された、孫子の言葉から引用された四字熟語といえば？", answers: ["風林火山", "ふうりんかざん"], info: "「疾きこと風の如く、其の徐かなること林の如く...」から引用。" }
                // ここに続きのデータを追加していく際は { name: ... }, の形式を守ってください
            ]
        },
        ancient: { 
            color: "#3498db", 
            questions: [
                { name: "聖徳太子", prompt: "A historical portrait of Prince Shotoku, traditional court robes, holding a scepter", msg: "私が制定した、日本最初の憲法といえば何？", answers: ["十七条憲法", "17条憲法", "じゅうななじょうけんぽう"], info: "604年制定。和の精神を説いたものです。" }
            ]
        }
    };

    let playerName = "";
    let currentEraData = null;
    let currentIdx = 0;
    let totalScore = 0;
    let correctCount = 0;
    let timeLeft = 30;
    let timerInterval;
    let isLocked = false;

    // --- 2. 画面切り替え ---
    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
    }

    function goToEraSelect() {
        playerName = document.getElementById('player-name').value.trim() || "名無しの権兵衛";
        document.getElementById('display-player-name').innerText = playerName;
        showScreen('era-screen');
    }

    // --- 3. ゲーム開始（ランダム選出） ---
    function startGame(eraKey) {
        if (!allQuizData[eraKey]) return;
        
        let allQuestions = [...allQuizData[eraKey].questions];
        // シャッフル
        allQuestions.sort(() => Math.random() - 0.5);
        
        // 30問選出（データが足りない場合は全件）
        const selectedQuestions = allQuestions.slice(0, 30);
        currentEraData = { color: allQuizData[eraKey].color, questions: selectedQuestions };

        document.documentElement.style.setProperty('--era-color', currentEraData.color);
        currentIdx = 0; totalScore = 0; correctCount = 0;
        showScreen('game-screen');
        loadQuestion();
    }

    // --- 4. 問題読み込み ---
    function loadQuestion() {
        isLocked = false;
        const data = currentEraData.questions[currentIdx];
        
        // 画像はプロンプトを使用してAIに描かせる（※実行環境に合わせた画像処理を想定）
        // ここでは便宜上、背景色を変更する処理に留めます
        document.getElementById('bg-image').style.backgroundColor = currentEraData.color;
        
        document.body.classList.remove('wrong-flash');
        document.getElementById('dialogue').innerHTML = `<strong>${data.name}：</strong><br>${data.msg}`;
        document.getElementById('info-area').style.display = 'none';
        document.getElementById('game-progress').innerText = `${currentIdx + 1} / ${currentEraData.questions.length}`;
        document.getElementById('current-score-display').innerText = `スコア: ${totalScore}`;
        
        const input = document.getElementById('user-answer');
        input.value = ''; input.disabled = false; input.style.display = 'block';
        document.getElementById('submit-btn').style.display = 'block';
        document.getElementById('next-btn').style.display = 'none';
        
        timeLeft = 30;
        updateTimerUI();
        startTimerLoop();
        setTimeout(() => input.focus(), 500);
    }

    function startTimerLoop() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            timeLeft -= 1; 
            updateTimerUI();
            if (timeLeft <= 0) finishQuestion('timeout');
        }, 1000);
    }

    function updateTimerUI() {
        const el = document.getElementById('timer-text');
        el.innerText = `残り ${Math.max(0, timeLeft)}秒`;
        el.style.color = timeLeft <= 5 ? "#ff4444" : "#fff";

        if (timeLeft <= 10 && timeLeft > 0 && !isLocked) {
            showHint();
        }
    }

    function showHint() {
        const data = currentEraData.questions[currentIdx];
        const dialogue = document.getElementById('dialogue');
        if (!dialogue.innerHTML.includes('助け舟')) {
            const kanaAnswer = data.answers.find(a => /^[ぁ-んー]*$/.test(a)) || data.answers[0];
            const firstChar = kanaAnswer.charAt(0);
            dialogue.innerHTML += `
                <div id="hint-msg" style="margin-top:10px; color:var(--gold); font-size:1rem; border-top:1px dashed rgba(212,175,55,0.5); padding-top:5px;">
                    <strong>${data.name}：</strong> ...「${firstChar}」から始まる言葉だ...（助け舟）
                </div>
            `;
        }
    }

    function checkAttempt() {
        if (isLocked || timeLeft <= 0) return;
        const data = currentEraData.questions[currentIdx];
        const ans = document.getElementById('user-answer').value.trim();
        
        if (data.answers.includes(ans)) {
            correctCount++;
            totalScore += (1000 + (timeLeft * 50));
            finishQuestion('correct');
        } else {
            isLocked = true; 
            timeLeft = Math.max(0, timeLeft - 5); // お手つきペナルティ
            updateTimerUI();
            document.body.classList.add('wrong-flash');
            setTimeout(() => {
                document.body.classList.remove('wrong-flash');
                isLocked = false;
            }, 500);
        }
    }

    function finishQuestion(result) {
        clearInterval(timerInterval); 
        isLocked = true;
        const data = currentEraData.questions[currentIdx];
        const correctAnswer = data.answers[0];

        if (result === 'correct') {
            document.getElementById('dialogue').innerHTML = `<span style="color:#4caf50;">【 正解 】</span><br><strong>${data.name}：</strong> 見事だ！答えは「${correctAnswer}」であったな。`;
        } else {
            document.getElementById('dialogue').innerHTML = `<span style="color:#f44336;">【 終了 】</span><br><strong>${data.name}：</strong> 正解は「${correctAnswer}」だ。`;
        }

        document.getElementById('info-area').innerHTML = `<strong>解説：</strong> ${data.info}`;
        document.getElementById('info-area').style.display = 'block';
        document.getElementById('user-answer').style.display = 'none';
        document.getElementById('submit-btn').style.display = 'none';
        document.getElementById('next-btn').style.display = 'block';
    }

    function nextQuestion() {
        currentIdx++;
        if (currentIdx < currentEraData.questions.length) loadQuestion();
        else showFinalResult();
    }

    function showFinalResult() {
        showScreen('result-screen');
        const totalCount = currentEraData.questions.length;
        document.getElementById('final-stats').innerHTML = `
            <p>${playerName}殿</p>
            <span style="font-size:2.5rem; color:var(--gold); font-weight:bold;">${totalScore.toLocaleString()} 点</span>
            <p>（正解数: ${correctCount} / ${totalCount}）</p>
        `;
    }

    document.getElementById('user-answer').addEventListener('keypress', (e) => { if (e.key === 'Enter') checkAttempt(); });
</script>
